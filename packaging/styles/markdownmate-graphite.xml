<?xml version="1.0" encoding="UTF-8"?>
<!-- Theme Graphite của MarkdownMate: chỉ đổi màu nền/chữ, phần tô cú pháp kế thừa Adwaita. -->
<style-scheme id="markdownmate-graphite" name="MarkdownMate Graphite" version="1.0" parent-scheme="Adwaita">
  <style name="text" foreground="#2b2b2b" background="#f2f2f2"/>
  <style name="line-numbers" foreground="#9a9a9a" background="#f2f2f2"/>
  <style name="current-line" background="#e8e8e8"/>
  <style name="selection" background="#c8ccd0"/>
  <style name="cursor" foreground="#2b2b2b"/>
</style-scheme>
